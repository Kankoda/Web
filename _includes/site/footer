<footer class="site-footer paper">
  <div class="wrapper paper">
    <hr />
  </div>
  <data class="u-url" href="{{ "/" | relative_url }}"></data>
  <div class="wrapper">
    <div class="row">
      {%- assign pages = site.pages -%}
      {%- assign paths_site = site.footer_pages_sitemap -%}
      {%- assign paths_app = site.footer_pages_app -%}
      
      <div class="column">
        <p class="footer-toggle">Site</p>
        <div class="footer-content">
          {% include kankoda/site/footer-links paths=site.footer.sitemap %}
        </div>
      </div>

      <div class="column">
        <p class="footer-toggle">News</p>
        <div class="footer-content">
          <a href="{{site.urls.blog}}">Blog</a>
          <a href="{{site.urls.rss}}">RSS</a>
          <a href="{{site.urls.newsletter}}">Newsletter</a>
        </div>
      </div>

      <div class="column">
        <p class="footer-toggle">Social</p>
        <div class="footer-content">
          <a href="{{site.urls.email}}">E-mail</a>
          <a href="{{site.urls.bluesky}}">Bluesky</a>
          <a href="{{site.urls.mastodon}}">Mastodon</a>
        </div>
      </div>

      <div class="column">
        <p class="footer-toggle">SDKs</p>
        <div class="footer-content">
          <a href="https://keyboardkit.com">KeyboardKit</a>
          <a href="https://kankoda.com/licensekit">LicenseKit</a>
          <a href="https://kankoda.com/mediakit">MediaKit</a>
          <a href="https://kankoda.com/vietnameseinput">Vietnamese Input</a>
        </div>
      </div>

      <div class="column">
        <p class="footer-toggle">Apps</p>
        <div class="footer-content">
          <a href="https://kankoda.com/emojipicker">Emoji Picker</a>
          <a href="https://keyboardkit.com/app">KeyboardKit</a>
          <a href="https://wally.app">Wally</a>
          <a href="https://kankoda.com/onetouchpaste">One Touch Paste</a>
        </div>
      </div>
    </div>
    
    <div class="copyright">
      © {{site.copyright_year}} <a href="{{site.copyright_url}}">{{site.copyright_owner}}</a>. All rights reserved.
    </div>
  </div>
</footer>
